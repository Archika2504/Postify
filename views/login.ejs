<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class=" main w-full  min-h-screen bg-zinc-900 text-white p-10">
        <h3 class="text-3xl tracking-tighter mb-5">Login Your Account</h3>
        <form action="/login" method="post">
            <input type="email" class="px-3 py-2 outline-none bg-transparent border-2 rounded-md border-zinc-800" name="email" placeholder="Email">
            <input type="password" class="px-3 py-2 outline-none bg-transparent border-2 rounded-md border-zinc-800" name="password" placeholder="Password">
            <input type="submit" class="px-3 py-2 bg-blue-500 rounded-md" value="Login Account">
        </form>

    </div>
    
</body>
</html>