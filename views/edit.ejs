<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class=" main w-full  min-h-screen bg-zinc-900 text-white p-10">
        <div class=" w-full flex justify-end">
            <a class="bg-red-500 px-3 py-2 mt-3 text-sm rounded-md inline-block " href="/logout">Logout</a>
        </div>
        <h5 class="mb-5 inline-block">Edit your Post</h5>
        <form  class="post" method="POST" action="/update/<%= post._id %>">
            <textarea placeholder="What's on your mind? " class=" block p-3 outline-none w-1/3 resize-none border-transparent border-2 
            bg-zinc-800 rounded-md" name="content"><%= post.content %></textarea>
            <input class="px-3 py-2 bg-yellow-500 text-black block rounded-md w-40 mt-2 text-sm " type="submit" value="Update Post" >
        </form>
    </div>
</body>
</html>