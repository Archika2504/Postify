<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class=" main w-full  min-h-screen bg-zinc-900 text-white p-10">
        <div class=" w-full flex justify-end">
            <a class="bg-red-500 px-3 py-2 mt-3 text-sm rounded-md inline-block " href="/logout">Logout</a>
        </div>
        <h3 class="text-3xl tracking-tighter mb-5 mt-3"><span class="font-light">Hello</span>, <%= user.name %> 👋</h3>
        <h5 class="mb-5 inline-block">You can create a new post</h5>
        <form  class="post" method="POST" action="/post">
            <textarea placeholder="What's on your mind? " class=" block p-3 outline-none w-1/3 resize-none border-transparent border-2 bg-zinc-800 rounded-md" name="content"></textarea>
            <input class="px-3 py-2 bg-blue-500 block rounded-md w-40 mt-2 text-sm " type="submit" value="Create New Post" >
        </form>
        <div class="Posts mt-20">
            <h3 class="text-zinc-400">Your Posts</h3>
            <div class="postcontainer mt-5">
                <% user.posts.reverse().forEach(function(post){ %>
                    <div class=" mb-4 post w-1/3 p-4 rounded-md bg-zinc-800 border-2 border-zinc-800">
                        <h4 class="text-blue-500 mb-2"><%= user.username %></h4>
                        <p class="text-sm tracking-tight mb-2"><%= post.content %></p>
                        <small class="mt-2 inline-block"><%= post.likes.length %> likes</small>
                        <div class="bttns flex mt-1 gap-4">
                            <a class="text-blue-500" href="/like/<%= post._id %>">
                                <%= post.likes.indexOf(user._id)===-1? "Like":"Unlike" %>
                            </a>
                            <a class="text-zinc-500" href="/edit/<%= post._id %>">edit</a>

                        </div>
                    </div>
                <% }) %>
                
            </div>
        </div>
    </div>
</body>
</html>